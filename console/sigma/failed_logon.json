{
  "title": "Failed logon (SSH / Windows)",
  "id": "itsoc-failed-logon",
  "status": "stable",
  "level": "high",
  "logsource": {"category": "authentication"},
  "detection": {
    "selection": {
      "msg|contains": [
        "Failed password",
        "authentication failure",
        "failed logon",
        "4625",
        "auth failed for user"
      ]
    },
    "condition": "selection"
  },
  "tags": ["attack.t1110"]
}
